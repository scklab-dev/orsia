# Copy to .env in the repository root and keep .env private (chmod 600 .env).
# notebooks/support/prepare_five_band.py reads only the CDS settings from .env.
# Existing environment values take precedence; ${...} interpolation is disabled.
CDSAPI_URL=
CDSAPI_KEY=

# Space-Track callers supply (username, password) through the credentials callable
# for orsia_data.services.space_track.SpaceTrackClient.
# Library APIs do not load .env automatically.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
